# Optional in Phase 1. The dashboard preview runs without Firebase credentials.
# Copy to .env.local when implementing real authentication in Phase 2.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin credentials belong in a server secret store, never NEXT_PUBLIC_*.
